{
  "name": "drwael-desktop",
  "productName": "Dr. Wael",
  "version": "1.0.0",
  "description": "Dr. Wael desktop app",
  "main": "main.js",
  "author": "Dr. Wael <info@drwael.app>",
  "homepage": "https://github.com/khaledahmed34567/DrWael-Desktop",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "node server.js",
    "build": "node scripts/build-html.js",
    "start": "node server.js",
    "desktop:zip": "node scripts/build-desktop-zip.js",
    "lint": "node scripts/lint.js",
    "electron:start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {},
  "build": {
    "appId": "com.drwael.desktop",
    "productName": "Dr. Wael",
    "copyright": "Dr. Wael",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "bridge.js",
      "dialog.html",
      "dialog-preload.js",
      "config.json",
      "app/**",
      "assets/**",
      "build/**",
      "package.json",
      "store-update.js",
      "store-startup.js",
      "store-gate-preload.js",
      "store-gate-renderer.js",
      "store-gate.html",
      "store-gate.css",
      "desktop-http.js",
      "desktop-security.js",
      "desktop-widget.js",
      "desktop-widget-preload.js",
      "desktop-widget-renderer.js",
      "desktop-widget.html",
      "desktop-widget.css"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "DrWael-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dr. Wael",
      "installerSidebar": "build/side_banner.bmp",
      "uninstallerSidebar": "build/side_banner.bmp",
      "installerHeader": "build/header_logo.bmp",
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "artifactName": "DrWael-mac.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "executableName": "drwael-desktop",
      "category": "Education",
      "maintainer": "Dr. Wael <info@drwael.app>",
      "artifactName": "DrWael-linux.${ext}"
    }
  }
}

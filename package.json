{
  "name": "drwael-desktop",
  "productName": "Dr. Wael",
  "version": "1.0.0",
  "description": "Dr. Wael desktop app",
  "main": "main.js",
  "author": "Dr. Wael <info@drwael.app>",
  "homepage": "https://github.com/khaledahmed34567/DrWael-Desktop",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "node server.js",
    "build": "node -e \"const fs=require('fs');if(!fs.existsSync('app/index.html'))process.exit(1);console.log('Build OK')\"",
    "start": "node server.js",
    "lint": "node --check server.js main.js preload.js bridge.js dialog-preload.js app/course-alerts.js app/course-features.js tests/course-alerts.test.js tests/course-features.test.js && node -e \"const fs=require('fs'),vm=require('vm'),h=fs.readFileSync('app/index.html','utf8');for(const m of h.matchAll(/<script(?![^>]*\\\\bsrc=)[^>]*>([\\\\s\\\\S]*?)<\\\\/script>/gi))new vm.Script(m[1]);console.log('Lint OK')\"",
    "electron:start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {},
  "build": {
    "appId": "com.drwael.desktop",
    "productName": "Dr. Wael",
    "copyright": "Dr. Wael",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": ["main.js", "preload.js", "bridge.js", "dialog.html", "dialog-preload.js", "config.json", "app/**", "assets/**", "package.json"],
    "win": {
      "target": [{
        "target": "nsis",
        "arch": ["x64"]
      }],
      "icon": "build/icon.png",
      "artifactName": "DrWael-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Dr. Wael"
    },
    "mac": {
      "target": [{
        "target": "dmg",
        "arch": ["universal"]
      }, {
        "target": "zip",
        "arch": ["universal"]
      }],
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "artifactName": "DrWael-mac.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icon.png",
      "category": "Education",
      "maintainer": "Dr. Wael <info@drwael.app>",
      "artifactName": "DrWael-linux.${ext}"
    },
    "publish": [{
      "provider": "github",
      "owner": "khaledahmed34567",
      "repo": "DrWael-Desktop",
      "releaseType": "release"
    }]
  }
}
